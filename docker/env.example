# Environment Configuration for Docker Compose

# Node Environment
NODE_ENV=production

# Database Configuration
MONGO_ROOT_PASSWORD=your-secure-mongo-root-password
MONGO_USER_PASSWORD=your-secure-mongo-user-password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-make-it-long-and-random
JWT_EXPIRE=7d

# MPESA API Configuration
MPESA_CONSUMER_KEY=your-mpesa-consumer-key
MPESA_CONSUMER_SECRET=your-mpesa-consumer-secret
MPESA_SHORTCODE=your-business-shortcode
MPESA_PASSKEY=your-mpesa-passkey
MPESA_ENVIRONMENT=production
MPESA_BASE_URL=https://api.safaricom.co.ke

# Encryption (32 character key for AES-256)
ENCRYPTION_KEY=your-32-character-encryption-key-here

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# Security Configuration
BCRYPT_ROUNDS=12
MAX_FILE_SIZE=5242880
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Frontend Configuration
REACT_APP_API_URL=https://your-domain.com/api

# Redis Configuration
REDIS_PASSWORD=your-secure-redis-password

# SSL Configuration (for production)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem
